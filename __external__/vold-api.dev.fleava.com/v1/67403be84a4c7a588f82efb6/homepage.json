m","role":"master","role_id":null,"at":"2024-11-22T08:09:07.929Z"},"name":"tandjung_sari","websiteName":null,"template":null,"domain":null,"status":"published","options":{"menu_enabled_post":true,"featured":true,"disabled_property_menu":true,"disabled_language":true},"master":false,"featured":false,"created_at":"2024-11-22T08:08:09.098Z","updated_at":"2024-11-22T08:09:07.931Z","id":"67403be84a4c7a588f82efb6"},"folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-02-27T04:28:58.692Z"},"client":"67403be84a4c7a588f82efb6","parent":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-01-23T07:11:29.217Z"},"client":"67403be84a4c7a588f82efb6","parent":null,"name":"our story","uri":"our-story","type":null,"created_at":"2025-01-23T07:11:29.227Z","updated_at":"2025-01-23T07:11:29.227Z","id":"6791eba1de842e3d6dde499d"},"name":"our story new","uri":"our-story/our-story-new","type":null,"created_at":"2025-02-27T04:28:58.701Z","updated_at":"2025-02-27T04:28:58.701Z","id":"67bfea0a281931efcbf4cdb2"},"title":null,"description":null,"size":276231,"type":"IMG","original":"1960b (1).jpg","path":"our-story/our-story-new/e5a331c4-aabb-49a1-bd7b-37aaf03d22ce","is_aws":true,"aws_file_url":"https://vold-independent.s3.ap-southeast-1.amazonaws.com/","filename":{"webp":"webp/1960b-1jpg.webp","big":"big/1960b-1jpg.jpeg","medium":"medium/1960b-1jpg.jpeg","blur":"blur/1960b-1jpg.jpeg","raw":"raw/1960b-1jpg.jpeg"},"created_at":"2025-02-27T04:48:07.733Z","updated_at":"2025-02-27T04:48:07.733Z","id":"67bfee87281931efcbf4f028"}},{"title":"If you conjure Sanur in the early 1960s when the Tandjung Sari was born, the vision you get will be a quiet one. The beach then was nearly deserted during the day, except for the coming and going of fishermen in their bright little boats and, at low tide, the harvesting of coral from the lagoon's protective reef. ","image":{"last_edited":null,"client":{"_id":"67403be84a4c7a588f82efb6","last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"master","role_id":null,"at":"2024-11-22T08:09:07.929Z"},"name":"tandjung_sari","websiteName":null,"template":null,"domain":null,"status":"published","options":{"menu_enabled_post":true,"featured":true,"disabled_property_menu":true,"disabled_language":true},"master":false,"featured":false,"created_at":"2024-11-22T08:08:09.098Z","updated_at":"2024-11-22T08:09:07.931Z","id":"67403be84a4c7a588f82efb6"},"folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-02-27T04:28:58.692Z"},"client":"67403be84a4c7a588f82efb6","parent":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-01-23T07:11:29.217Z"},"client":"67403be84a4c7a588f82efb6","parent":null,"name":"our story","uri":"our-story","type":null,"created_at":"2025-01-23T07:11:29.227Z","updated_at":"2025-01-23T07:11:29.227Z","id":"6791eba1de842e3d6dde499d"},"name":"our story new","uri":"our-story/our-story-new","type":null,"created_at":"2025-02-27T04:28:58.701Z","updated_at":"2025-02-27T04:28:58.701Z","id":"67bfea0a281931efcbf4cdb2"},"title":null,"description":null,"size":405408,"type":"IMG","original":"Hero Image 1960 (1).jpg","path":"our-story/our-story-new/32df6f25-0834-4782-9b02-87abf14cb739","is_aws":true,"aws_file_url":"https://vold-independent.s3.ap-southeast-1.amazonaws.com/","filename":{"webp":"webp/hero-image-1960-1jpg.webp","big":"big/hero-image-1960-1jpg.jpeg","medium":"medium/hero-image-1960-1jpg.jpeg","blur":"blur/hero-image-1960-1jpg.jpeg","raw":"raw/hero-image-1960-1jpg.jpeg"},"created_at":"2025-02-27T04:52:02.945Z","updated_at":"2025-02-27T04:52:02.945Z","id":"67bfef72281931efcbf4f719"}}]}},{"id":"d3a6ae97-53a4-4cb8-b150-2f4448d3bbe2","section":"678f1e6cde842e3d6dbb26cf","sectionId":"HorizontalSplitNarrative1","data":{"description_2":{"en":"<p>As tourism continued to grow, Sanur became the most prestigious address on the island.</p>"},"title_1":{"en":"The Tandjung Sari did not intend to become the seminal boutique hotel of tropical Asia."},"description_1":{"en":"<p>It began as a place to spend the night for its owner, Wija Wawo-Runtu (1926 - 2001), and his family when they visited Bali from Jakarta on shopping trips for their antique business.</p><p><br></p><p>The Wawo-Runtu's little paradise attracted friends from Jakarta, and by 1962, they had four small bungalows for friends who wished to visit Bali.</p><p><br></p><p>Within a few years, Tandjung Sari was internationally renowned among smart people as the place to stay if you could get in.</p>"},"title_2":{"en":"Bali's tourism industry began to flourish, leading to the expansion of the island's international airport, which was officially inaugurated as Bali International Airport Ngurah Rai in August 1969.  "},"image_big":{"last_edited":null,"client":"67403be84a4c7a588f82efb6","folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-02-27T04:28:58.692Z"},"client":"67403be84a4c7a588f82efb6","parent":"6791eba1de842e3d6dde499d","name":"our story new","uri":"our-story/our-story-new","type":null,"created_at":"2025-02-27T04:28:58.701Z","updated_at":"2025-02-27T04:28:58.701Z","id":"67bfea0a281931efcbf4cdb2"},"title":null,"description":null,"size":575831,"type":"IMG","original":"Resize 3.jpg","path":"our-story/our-story-new/3a051f09-b286-4b96-a29f-12002e1a2641","is_aws":true,"aws_file_url":"https://vold-independent.s3.ap-southeast-1.amazonaws.com/","filename":{"webp":"webp/resize-3jpg.webp","big":"big/resize-3jpg.jpeg","medium":"medium/resize-3jpg.jpeg","blur":"blur/resize-3jpg.jpeg","raw":"raw/resize-3jpg.jpeg"},"created_at":"2025-07-03T07:51:29.542Z","updated_at":"2025-07-03T07:51:29.542Z","id":"6866368108fac445788f6a20"},"image_small":{"last_edited":null,"client":{"_id":"67403be84a4c7a588f82efb6","last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"master","role_id":null,"at":"2024-11-22T08:09:07.929Z"},"name":"tandjung_sari","websiteName":null,"template":null,"domain":null,"status":"published","options":{"menu_enabled_post":true,"featured":true,"disabled_property_menu":true,"disabled_language":true},"master":false,"featured":false,"created_at":"2024-11-22T08:08:09.098Z","updated_at":"2024-11-22T08:09:07.931Z","id":"67403be84a4c7a588f82efb6"},"folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-01-23T07:11:29.217Z"},"client":"67403be84a4c7a588f82efb6","parent":null,"name":"our story","uri":"our-story","type":null,"created_at":"2025-01-23T07:11:29.227Z","updated_at":"2025-01-23T07:11:29.227Z","id":"6791eba1de842e3d6dde499d"},"title":null,"description":null,"size":173867,"type":"IMG","original":"Frame 38608.png","path":"our-story/d7097ad6-287d-4346-9e65-554e294b0b0a","is_aws":true,"aws_file_url":"https://vold-independent.s3.ap-southeast-1.amazonaws.com/","filename":{"webp":"webp/frame-38608png.webp","big":"big/frame-38608png.png","medium":"medium/frame-38608png.png","blur":"blur/frame-38608png.png","raw":"raw/frame-38608png.png"},"created_at":"2025-01-24T08:36:16.340Z","updated_at":"2025-01-24T08:36:16.340Z","id":"67935100de842e3d6dee69f5"}},"title":"Horizontal Split Narrative 1"},{"id":"7598a3c7-3db7-42d4-abf5-f951a4a78340","section":"6790afa5de842e3d6dce9e9f","sectionId":"HorizontalSplitImageTextOverlay","data":{"description":{"en":"<p>They wanted to feel the air of Bali on their skin and to live in what they imagined was a Balinese way but more comfortably.</p>"},"title":{"en":"Wija understood that visitors wanted intimacy with Bali. "},"image":{"last_edited":null,"client":"67403be84a4c7a588f82efb6","folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-02-27T04:28:58.692Z"},"client":"67403be84a4c7a588f82efb6","parent":"6791eba1de842e3d6dde499d","name":"our story new","uri":"our-story/our-story-new","type":null,"created_at":"2025-02-27T04:28:58.701Z","updated_at":"2025-02-27T04:28:58.701Z","id":"67bfea0a281931efcbf4cdb2"},"title":null,"description":null,"size":1221764,"type":"IMG","original":"Resize 1.jpg","path":"our-story/our-story-new/ce8c9c89-af9c-44e1-9760-3854622c0ce9","is_aws":true,"aws_file_url":"https://vold-independent.s3.ap-southeast-1.amazonaws.com/","filename":{"webp":"webp/resize-1jpg.webp","big":"big/resize-1jpg.jpeg","medium":"medium/resize-1jpg.jpeg","blur":"blur/resize-1jpg.jpeg","raw":"raw/resize-1jpg.jpeg"},"created_at":"2025-07-03T07:51:29.540Z","updated_at":"2025-07-03T07:51:29.540Z","id":"6866368108fac445788f6a1e"},"parallax":true},"title":"Horizontal Split Image Text Overlay"},{"id":"aad4e7ce-53cf-4efe-9b5d-fdfddc4c9577","section":"678f9436de842e3d6dbfe529","sectionId":"HorizontalSplitImageText1","title":"Horizontal Split Image Text 1","data":{"description_2":{"en":"<p>In February 1974, Indonesia hosted the Pacific Asia Travel Association (PATA) conference, and a few months earlier, in October 1973, Bali Hyatt was completed.</p><p><br></p><p>On a par with the expanded Tandjung Sari, with its sixteen new bungalows normally full, the restaurant was a powerful magnet, too. <a href=\"https://www.nytimes.com/1974/11/14/archives/by-the-moonlight-in-bali-rijstaffel-that-stands-uncontested-common.html\">The Tandjung Sari's famous cuisine captivated Craig Claiborne, a food writer and former editor of<i> The</i> <i>New York Times</i>, who devoted a chapter to Tatie Wawo-Runtu's recipe for Soto Ayam.</a></p><p><br></p><p>When the structures were still new and the hotel was doing very well, there were lots of celebrated guests: Calvin Klein, Kirk Douglas, David Bowie, Mick Jagger, Queen Ingrid of Denmark, Margaret Mead, Ingrid Bergman, Annie Lennox, Ringo Starr, Yoko Ono, Paul Getty Jr. and his wife Talitha, and Lionel Poilâne.</p>"},"title":{"en":"The success of the Tandjung Sari convinced him that the concept could be taken to a larger scale. "},"description_1":{"en":"<p>That inspired the development of the Batujimbar Estate.</p>"},"image":{"last_edited":null,"client":{"_id":"67403be84a4c7a588f82efb6","last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"master","role_id":null,"at":"2024-11-22T08:09:07.929Z"},"name":"tandjung_sari","websiteName":null,"template":null,"domain":null,"status":"published","options":{"menu_enabled_post":true,"featured":true,"disabled_property_menu":true,"disabled_language":true},"master":false,"featured":false,"created_at":"2024-11-22T08:08:09.098Z","updated_at":"2024-11-22T08:09:07.931Z","id":"67403be84a4c7a588f82efb6"},"folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-02-27T04:28:58.692Z"},"client":"67403be84a4c7a588f82efb6","parent":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-01-23T07:11:29.217Z"},"client":"67403be84a4c7a588f82efb6","parent":null,"name":"our story","uri":"our-story","type":null,"created_at":"2025-01-23T07:11:29.227Z","updated_at":"2025-01-23T07:11:29.227Z","id":"6791eba1de842e3d6dde499d"},"name":"our story new","uri":"our-story/our-story-new","type":null,"created_at":"2025-02-27T04:28:58.701Z","updated_at":"2025-02-27T04:28:58.701Z","id":"67bfea0a281931efcbf4cdb2"},"title":null,"description":null,"size":924140,"type":"IMG","original":"15 1.png","path":"our-story/our-story-new/3167b950-e7a0-4b1e-8c22-008f9b33ce1b","is_aws":true,"aws_file_url":"https://vold-independent.s3.ap-southeast-1.amazonaws.com/","filename":{"webp":"webp/15-1png.webp","big":"big/15-1png.png","medium":"medium/15-1png.png","blur":"blur/15-1png.png","raw":"raw/15-1png.png"},"created_at":"2025-07-11T06:10:08.546Z","updated_at":"2025-07-11T06:10:08.546Z","id":"6870aac056623b48147c1079"}}},{"id":"8919503f-25a9-4ea2-86b5-6fe918b2023b","section":"6790afa5de842e3d6dce9e9f","sectionId":"HorizontalSplitImageTextOverlay","data":{"description":{"en":"<p>Numerous cultural activities were initiated, and the Tandjung Sari Foundation was established in September 1987 to formalize the commitment to preserve classical dance and other aspects of Balinese culture.</p><p><br></p><p>Dance lessons are still regularly scheduled on Friday and Sunday afternoons to tutor children from the local banjar, and their performances take place on stage every first and third Saturday evening of the month.</p>"},"title":{"en":"The Tandjung Sari cultural performance has significantly contributed to the place's legend."},"image":{"last_edited":null,"client":{"_id":"67403be84a4c7a588f82efb6","last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"master","role_id":null,"at":"2024-11-22T08:09:07.929Z"},"name":"tandjung_sari","websiteName":null,"template":null,"domain":null,"status":"published","options":{"menu_enabled_post":true,"featured":true,"disabled_property_menu":true,"disabled_language":true},"master":false,"featured":false,"created_at":"2024-11-22T08:08:09.098Z","updated_at":"2024-11-22T08:09:07.931Z","id":"67403be84a4c7a588f82efb6"},"folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-01-23T07:11:29.217Z"},"client":"67403be84a4c7a588f82efb6","parent":null,"name":"our story","uri":"our-story","type":null,"created_at":"2025-01-23T07:11:29.227Z","updated_at":"2025-01-23T07:11:29.227Z","id":"6791eba1de842e3d6dde499d"},"title":null,"description":null,"size":1174075,"type":"IMG","original":"Snapinsta.app_272696868_953191035583086_43829194325254783_n_1080 1.png","path":"our-story/2f890b36-b82c-4bfa-8f51-fac40fcc3048","is_aws":true,"aws_file_url":"https://vold-independent.s3.ap-southeast-1.amazonaws.com/","filename":{"webp":"webp/snapinstaapp27269686895319103558308643829194325254783n1080-1png.webp","big":"big/snapinstaapp27269686895319103558308643829194325254783n1080-1png.png","medium":"medium/snapinstaapp27269686895319103558308643829194325254783n1080-1png.png","blur":"blur/snapinstaapp27269686895319103558308643829194325254783n1080-1png.png","raw":"raw/snapinstaapp27269686895319103558308643829194325254783n1080-1png.png"},"created_at":"2025-01-23T08:02:36.574Z","updated_at":"2025-01-23T08:02:36.574Z","id":"6791f79cde842e3d6ddeb9c3"},"parallax":true},"title":"Horizontal Split Image Text Overlay"},{"id":"34343a0b-1d06-49af-8fbd-2b4d8a84ef26","section":"6790f150de842e3d6dd3a862","sectionId":"HorizontalNarrativeWithImage","title":"Horizontal Narrative with Image","data":{"title_1":{"en":"For years, the hotel had been coasting from the boom years of the 1970s and '80s, shocked by the impact of the 1991 Gulf War, the 1997 financial crisis, Wija Wawo-Runtu's passing, and the 2003 SARS epidemic."},"description_1":{"en":"<p>Then came the gentle renaissance. In 2005, the Tandjung Sari underwent its first renovations</p>"},"description_2":{"en":"<p>The book tells how the hotel grew, the challenges and triumphs, and the people who made it happen. The book has become known for telling the early '60s tourism story in Sanur and enticing readers to dig more into Balinese architecture.</p><p><br></p><p>Another step of the 55-year milestone (2017) was celebrated with the Tandjung Sari documentary film, which portrayed the journey from its early days.</p>"},"title_2":{"en":"At the age of fifty in 2012, the hotel was\ndeeply rejuvenated from within. To celebrate the golden anniversary of Tandjung\nSari, the remarkable book  <a href=\"https://vold-independent.s3.ap-southeast-1.amazonaws.com/our-story/fcd942e0-9bde-426e-940a-4f6b0400600e/tandjung-sari-bookpdf.pdf\">Tandjung Sari—A Magical Door to Bali</a>&nbsp;was launched."},"image":{"last_edited":null,"client":{"_id":"67403be84a4c7a588f82efb6","last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"master","role_id":null,"at":"2024-11-22T08:09:07.929Z"},"name":"tandjung_sari","websiteName":null,"template":null,"domain":null,"status":"published","options":{"menu_enabled_post":true,"featured":true,"disabled_property_menu":true,"disabled_language":true},"master":false,"featured":false,"created_at":"2024-11-22T08:08:09.098Z","updated_at":"2024-11-22T08:09:07.931Z","id":"67403be84a4c7a588f82efb6"},"folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-02-27T04:28:58.692Z"},"client":"67403be84a4c7a588f82efb6","parent":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-01-23T07:11:29.217Z"},"client":"67403be84a4c7a588f82efb6","parent":null,"name":"our story","uri":"our-story","type":null,"created_at":"2025-01-23T07:11:29.227Z","updated_at":"2025-01-23T07:11:29.227Z","id":"6791eba1de842e3d6dde499d"},"name":"our story new","uri":"our-story/our-story-new","type":null,"created_at":"2025-02-27T04:28:58.701Z","updated_at":"2025-02-27T04:28:58.701Z","id":"67bfea0a281931efcbf4cdb2"},"title":null,"description":null,"size":236728,"type":"IMG","original":"20220726_133315 1.jpg","path":"our-story/our-story-new/bc419d97-6001-4ab2-9dad-a9baca6fe401","is_aws":true,"aws_file_url":"https://vold-independent.s3.ap-southeast-1.amazonaws.com/","filename":{"webp":"webp/20220726133315-1jpg.webp","big":"big/20220726133315-1jpg.jpeg","medium":"medium/20220726133315-1jpg.jpeg","blur":"blur/20220726133315-1jpg.jpeg","raw":"raw/20220726133315-1jpg.jpeg"},"created_at":"2025-07-03T08:16:00.258Z","updated_at":"2025-07-03T08:16:00.258Z","id":"68663c4008fac445788f940d"},"image_small":{"last_edited":null,"client":{"_id":"67403be84a4c7a588f82efb6","last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"master","role_id":null,"at":"2024-11-22T08:09:07.929Z"},"name":"tandjung_sari","websiteName":null,"template":null,"domain":null,"status":"published","options":{"menu_enabled_post":true,"featured":true,"disabled_property_menu":true,"disabled_language":true},"master":false,"featured":false,"created_at":"2024-11-22T08:08:09.098Z","updated_at":"2024-11-22T08:09:07.931Z","id":"67403be84a4c7a588f82efb6"},"folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-01-23T07:11:29.217Z"},"client":"67403be84a4c7a588f82efb6","parent":null,"name":"our story","uri":"our-story","type":null,"created_at":"2025-01-23T07:11:29.227Z","updated_at":"2025-01-23T07:11:29.227Z","id":"6791eba1de842e3d6dde499d"},"title":null,"description":null,"size":19831,"type":"IMG","original":"Pillar Ornaments.jpg","path":"our-story/b664b694-476a-4c5c-980c-7abfc6b26752","is_aws":true,"aws_file_url":"https://vold-independent.s3.ap-southeast-1.amazonaws.com/","filename":{"webp":"webp/pillar-ornamentsjpg.webp","big":"big/pillar-ornamentsjpg.jpeg","medium":"medium/pillar-ornamentsjpg.jpeg","blur":"blur/pillar-ornamentsjpg.jpeg","raw":"raw/pillar-ornamentsjpg.jpeg"},"created_at":"2025-06-22T08:05:25.104Z","updated_at":"2025-06-22T08:05:25.104Z","id":"6857b94508fac44578d5dbd6"}}},{"id":"d6b1d953-f71e-4b23-bc8a-618dc8be39e2","section":"6791d6f4de842e3d6ddce8c9","sectionId":"HorizontalSplitImageText2","title":"Horizontal Split Image Text 2","data":{"description":{"en":"<p>What drew people was the Tandjung Sari's judicious blend of the lowkey and luxurious. The architecture was simple, using local materials and Balinese building techniques, yet the location was on a prime beachfront with wonderful gardens. The rooms were furnished with Balinese antiques, and the hospitality was warm and sophisticated.</p><p><br></p><p>Guests felt they were experiencing a highly refined version of \"the real Bali\" with all its sounds and silences, deep perfumes, bare-handedness and hilarity, and powerful enchantment at the edge of a spangled sea.</p>"},"title":{"en":"The Tandjung Sari remains a treasure today, still run by the Wawo-Runtu family, discreet and elegantly modest, an ageless beauty."},"image":{"last_edited":null,"client":{"_id":"67403be84a4c7a588f82efb6","last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"master","role_id":null,"at":"2024-11-22T08:09:07.929Z"},"name":"tandjung_sari","websiteName":null,"template":null,"domain":null,"status":"published","options":{"menu_enabled_post":true,"featured":true,"disabled_property_menu":true,"disabled_language":true},"master":false,"featured":false,"created_at":"2024-11-22T08:08:09.098Z","updated_at":"2024-11-22T08:09:07.931Z","id":"67403be84a4c7a588f82efb6"},"folder":{"last_edited":{"id":"63e5ac653c4f8cdfac5f31b8","name":"Admin Fleava","email":"admin@fleava.com","role":"developer","role_id":"67403be84a4c7a588f82efb7","at":"2025-01-23T07:11:29.217Z"},"client":"67403be84a4c7a588f82efb6","parent":null,"name":"our story","uri":"our-story","type":null,"created_at":"2025-01-23T07:11:29.227Z","updated_at":"2025-01-23T07:11:29.227Z","id":"6791eba1de842e3d6dde499d"},"title":null,"description":null,"size":905535,"type":"IMG","original":"DSC06901 1.png","path":"our-story/af1a69d3-0d6e-4644-914a-733535274f84","is_aws":true,"aws_file_url":"https:/